{
  "version": 2,
  "rewrites": [
    { "source": "/api/auth/login",           "destination": "/api/auth/login.js" },
    { "source": "/api/auth/register",        "destination": "/api/auth/register.js" },
    { "source": "/api/auth/logout",          "destination": "/api/auth/logout.js" },
    { "source": "/api/auth/me",              "destination": "/api/auth/me.js" },

    { "source": "/api/tests/:id",            "destination": "/api/tests/index.js?id=:id" },
    { "source": "/api/tests",                "destination": "/api/tests/index.js" },

    { "source": "/api/videos/:id",           "destination": "/api/videos/index.js?id=:id" },
    { "source": "/api/videos",               "destination": "/api/videos/index.js" },

    { "source": "/api/teachers",             "destination": "/api/teachers/index.js" },
    { "source": "/api/media-signature",      "destination": "/api/media-signature.js" },
    { "source": "/api/site-settings",        "destination": "/api/site-settings.js" },

    { "source": "/api/news/:id",             "destination": "/api/news/index.js?id=:id" },
    { "source": "/api/news",                 "destination": "/api/news/index.js" },

    { "source": "/api/users/:id",            "destination": "/api/users/index.js?id=:id" },
    { "source": "/api/users",                "destination": "/api/users/index.js" },

    { "source": "/api/teacher-tests",        "destination": "/api/teacher-tests/index.js" },
    { "source": "/api/premium",              "destination": "/api/premium/index.js" },
    { "source": "/api/payments",             "destination": "/api/payments/index.js" },
    { "source": "/api/stats",                "destination": "/api/stats/index.js" },
    { "source": "/api/points",               "destination": "/api/points.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",      "value": "https://bizimriyaziyyat.work.gd" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods",     "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers",     "value": "Content-Type" },
        { "key": "X-Frame-Options",                  "value": "DENY" },
        { "key": "X-Content-Type-Options",           "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
