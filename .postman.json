      {
        "name": "Teacher Tests",
        "item": [
          {
            "name": "Request Test-Add Access",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Authorization", "value": "Bearer {{token}}" }
              ],
              "url": "{{base_url}}/teacher-tests/request-access",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200 or 201', function () {",
                    "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                    "});",
                    "const json = pm.response.json();",
                    "pm.test('Has status field', function () {",
                    "  pm.expect(json).to.have.property('status');",
                    "});"
                  ]
                }
              }
            ]
          },
          {
            "name": "Submit Teacher Test",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Authorization", "value": "Bearer {{token}}" }
              ],
              "url": "{{base_url}}/teacher-tests",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"title\": \"Cəbr — Tənliklər\",\n  \"emoji\": \"📝\",\n  \"difficulty\": \"Orta\",\n  \"duration\": 15,\n  \"isPremium\": false,\n  \"description\": \"Tənliklər mövzusu üzrə yoxlama sınağı.\",\n  \"questions\": [\n    {\n      \"question\": \"2x + 4 = 10 tənliyinin həlli nədir?\",\n      \"options\": [\"x=2\", \"x=3\", \"x=4\", \"x=5\"],\n      \"correctAnswer\": 1\n    },\n    {\n      \"question\": \"3x - 6 = 0 tənliyinin həlli nədir?\",\n      \"options\": [\"x=1\", \"x=2\", \"x=3\", \"x=6\"],\n      \"correctAnswer\": 1\n    }\n  ]\n}"
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200 or 201', function () {",
                    "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                    "});",
                    "const json = pm.response.json();",
                    "pm.test('Has id', function () {",
                    "  pm.expect(json).to.have.property('id');",
                    "});",
                    "pm.test('Status is pending', function () {",
                    "  pm.expect(json.status).to.equal('pending');",
                    "});",
                    "if (json.id) pm.collectionVariables.set('teacherTestId', json.id);"
                  ]
                }
              }
            ]
          },
