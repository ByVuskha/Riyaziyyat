        "name": "Auth",
        "item": [
          {
            "name": "Register",
            "request": {
              "method": "POST",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "url": "{{base_url}}/auth/register",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"userType\": \"student\"\n}"
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200 or 201', function () {",
                    "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                    "});",
                    "const json = pm.response.json();",
                    "if (json.token) pm.collectionVariables.set('token', json.token);"
                  ]
                }
              }
            ]
          },
          {
            "name": "Login",
            "request": {
              "method": "POST",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "url": "{{base_url}}/auth/login",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"email\": \"admin@riyazmath.az\",\n  \"password\": \"admin123\"\n}"
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Login successful', function () {",
                    "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                    "});",
                    "const json = pm.response.json();",
                    "if (json.token) pm.collectionVariables.set('token', json.token);",
                    "pm.test('Token returned', function () {",
                    "  pm.expect(json.token).to.be.a('string');",
                    "});"
                  ]
                }
              }
            ]
          },
          {
            "name": "Get Current User",
            "request": {
              "method": "GET",
              "header": [
                { "key": "Authorization", "value": "Bearer {{token}}" }
              ],
              "url": "{{base_url}}/auth/me"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200', function () {",
                    "  pm.response.to.have.status(200);",
                    "});",
                    "const json = pm.response.json();",
                    "pm.test('User has email', function () {",
                    "  pm.expect(json.email).to.be.a('string');",
                    "});"
                  ]
                }
              }
            ]
          }
        ]
