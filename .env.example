# Copy this file to .env and fill in real values before deploying.
# In Vercel: add these as Environment Variables in the project settings.

# Upstash Redis (from upstash.io → Redis → REST API)
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Generate a unique secret with Node or PowerShell; never use a short/example value.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this in Vercel Project Settings > Environment Variables; never commit the real value.
JWT_SECRET=

# Password-reset email (EmailJS)
EMAILJS_SERVICE_ID=
EMAILJS_RESET_TEMPLATE_ID=
EMAILJS_VERIFY_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
APP_URL=https://bizimriyaziyyat.vercel.app

# Cloudinary media storage (signed direct video upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Node environment
NODE_ENV=production
yy
