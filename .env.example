# Copy this file to .env and fill in real values before deploying.
# In Vercel: add these as Environment Variables in the project settings.

# Upstash Redis (from upstash.io → Redis → REST API)
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_256bit_random_secret_here

# Node environment
NODE_ENV=production
