# Copy this file to .env and fill in real values before deploying.
# In Vercel: add these as Environment Variables in the project settings.

# Upstash Redis (from upstash.io → Redis → REST API)
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Generate a unique 64-character hex secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this in Vercel Project Settings > Environment Variables; never commit the real value.
JWT_SECRET=

# Cloudinary media storage (signed direct video upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Node environment
NODE_ENV=production
yy
